<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" style="-fx-background-color: #f5f7fa; -fx-font-family: Arial;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="viewController.ModalidadViewController">
    <padding>
        <Insets bottom="18.0" left="20.0" right="20.0" top="18.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #183153;" text="Modalidades de alquiler" />

        <GridPane hgap="12.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Código" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="codigoField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Nombre" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="nombreField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="tipoCombo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="estadoCombo" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Precio diario" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="precioDiarioField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Duración mínima (días)" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="duracionMinimaField" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Descripción" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="descripcionField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Beneficios" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <TextField fx:id="beneficiosField" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="guardarButton" onAction="#registrarModalidad" text="Registrar modalidad" />
                <Button fx:id="editarButton" onAction="#editarModalidad" text="Editar seleccionada" disable="true" />
                <Button fx:id="eliminarButton" onAction="#eliminarModalidad" text="Eliminar seleccionada" disable="true" />
                <Button fx:id="cancelarButton" onAction="#cancelarEdicion" text="Cancelar edición" disable="true" />
                <Label fx:id="mensajeLabel" style="-fx-text-fill: #475569;" />
            </children>
        </HBox>

        <TableView fx:id="modalidadesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codigoColumn" prefWidth="80.0" text="Código" />
                <TableColumn fx:id="nombreColumn" prefWidth="130.0" text="Nombre" />
                <TableColumn fx:id="tipoColumn" prefWidth="110.0" text="Tipo" />
                <TableColumn fx:id="estadoColumn" prefWidth="100.0" text="Estado" />
                <TableColumn fx:id="precioColumn" prefWidth="110.0" text="Precio diario" />
                <TableColumn fx:id="duracionColumn" prefWidth="90.0" text="Mín. días" />
            </columns>
            <placeholder>
                <Label text="No hay modalidades registradas." />
            </placeholder>
        </TableView>
    </children>
</VBox>
