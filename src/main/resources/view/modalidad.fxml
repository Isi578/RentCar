<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="viewController.ModalidadViewController"
      style="-fx-background-color: #f5f7fa; -fx-font-family: Arial;">
    <padding>
        <Insets top="18.0" right="20.0" bottom="18.0" left="20.0" />
    </padding>
    <children>
        <Label text="Modalidades de alquiler"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #183153;" />

        <GridPane hgap="12.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="90.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Código" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="codigoField" promptText="Código"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <TextField fx:id="nombreField" promptText="Nombre"
                           GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Tipo" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="tipoCombo" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Estado" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <ComboBox fx:id="estadoCombo" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Precio diario" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="precioDiarioField" promptText="Precio diario"
                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="Duración mínima (días)" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <TextField fx:id="duracionMinimaField" promptText="Días"
                           GridPane.rowIndex="2" GridPane.columnIndex="3" />

                <Label text="Descripción" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="descripcionField" promptText="Descripción"
                           GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="Beneficios" GridPane.rowIndex="3" GridPane.columnIndex="2" />
                <TextField fx:id="beneficiosField" promptText="Beneficios"
                           GridPane.rowIndex="3" GridPane.columnIndex="3" />
            </children>
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button text="Registrar modalidad" onAction="#registrarModalidad" />
                <Label fx:id="mensajeLabel" style="-fx-text-fill: #475569;" />
            </children>
        </HBox>

        <TableView fx:id="modalidadesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codigoColumn" text="Código" prefWidth="80.0" />
                <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="130.0" />
                <TableColumn fx:id="tipoColumn" text="Tipo" prefWidth="110.0" />
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100.0" />
                <TableColumn fx:id="precioColumn" text="Precio diario" prefWidth="110.0" />
                <TableColumn fx:id="duracionColumn" text="Mín. días" prefWidth="90.0" />
            </columns>
            <placeholder>
                <Label text="No hay modalidades registradas." />
            </placeholder>
        </TableView>
    </children>
</VBox>
